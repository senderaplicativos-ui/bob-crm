{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.1.9",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/go/:name", "destination": "/api/go?i=:name" },
    { "source": "/((?!api/|go/).*)", "destination": "/index.html" }
  ]
}
