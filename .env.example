# ==========================================================================
# Bob CRM — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores. NUNCA commite o .env.
# ==========================================================================

# ---- Backend (Vercel serverless / api/*) — SEGREDOS, só no servidor ----

# String de conexão do MongoDB na VPS.
# Ex.: mongodb://usuario:senha@host:27017/
MONGODB_URI="mongodb://usuario:senha@host:27017/"

# Nome do banco onde ficam as coleções do CRM.
MONGODB_DB="bobcrm"

# Token secreto que protege a API /api/query contra acesso público.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
API_TOKEN="troque-por-um-token-aleatorio-longo"

# ---- Frontend (Vite / build) — visíveis no navegador ----

# Mesmo valor de API_TOKEN acima. Necessário porque o navegador precisa
# enviar o token no header x-api-token. (Sim, fica visível no bundle; a
# proteção real é evitar acesso anônimo casual à API do banco.)
VITE_API_TOKEN="troque-por-um-token-aleatorio-longo"

# Base da API. Em produção na Vercel, deixe vazio (mesmo domínio).
# Em dev local apontando para produção, use a URL completa.
VITE_API_BASE=""
